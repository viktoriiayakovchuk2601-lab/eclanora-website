# Développement : validation sans email, stockage ou journalisation des données.
QUOTE_MODE=test
SITE_URL=http://localhost:3000
PUBLICATION_APPROVED=false
# SMTP réel : TLS obligatoire, jamais de secrets NEXT_PUBLIC_*.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
QUOTE_FROM=
QUOTE_TO=
# Seulement derrière un proxy de confiance qui écrase X-Forwarded-For.
TRUST_PROXY=false
# Validations humaines ET contrôles techniques nécessaires avant publication.
LEGAL_APPROVED=false
DATA_PROCESSING_APPROVED=false
EDGE_RATE_LIMIT_CONFIGURED=false
